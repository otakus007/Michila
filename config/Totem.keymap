 *
 * Custom Mouseless Coding Keymap for TOTEM (with Left Scroll Encoder & Right 5-way Navigation Switch)
 * Optimized for: Neovim, Terminal Multiplexers (Tmux/WezTerm), Coding Agents (Antigravity/Cursor/Claude), and Windows WM
 */

// Pointing / Mouse speed configuration (must be defined before including mouse.h / pointing.h)
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1400  // Tốc độ di chuột bằng 5-way switch
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // Tốc độ cuộn bằng con lăn Scroll

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer definitions
#define BASE      0
#define NAV_WM    1
#define SYM_CODE  2
#define NUM_FN    3
#define AGENT_SYS 4

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>;
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    flavor = "balanced";
};

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    flavor = "tap-preferred";
};

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

/ {
    behaviors {
        // Home Row Mods tối ưu cho Neovim: chống dính phím khi gõ nhanh nhờ require-prior-idle-ms
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Cuộn dọc Lên/Xuống bằng con lăn bên Trái
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };

        // Cuộn ngang Trái/Phải khi giữ Layer NAV_WM
        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
            tap-ms = <20>;
        };
    };

    macros {
        // Lưu file nhanh trong Neovim: <ESC> : w <ENTER>
        vim_save: vim_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&kp ESC &kp COLON &kp W &kp RET>;
            label = "VIM_SAVE";
        };

        // Toán tử mũi tên mỏng: -> (C/C++, Rust, Go, PHP)
        arrow_thin: arrow_thin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW_THIN";
        };

        // Toán tử mũi tên béo: => (JS/TS, Rust, C#)
        arrow_fat: arrow_fat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW_FAT";
        };

        // Gõ nhanh khối code markdown ``` cho Coding Agent
        code_fence: code_fence {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "CODE_FENCE";
        };
    };

    combos {
        compatible = "zmk,combos";

        // --- Combos cho Neovim & Coding ---
        // J + K = ESC (Thoát Insert Mode tức thì)
        combo_esc {
            timeout-ms = <40>;
            key-positions = <16 17>;
            bindings = <&kp ESC>;
        };

        // K + L = : (Vào Command Mode của Neovim không cần giữ Shift)
        combo_colon {
            timeout-ms = <40>;
            key-positions = <17 18>;
            bindings = <&kp COLON>;
        };

        // D + F = Lưu file Neovim (:w)
        combo_vim_save {
            timeout-ms = <40>;
            key-positions = <12 13>;
            bindings = <&vim_save>;
        };

        // H + J = ->
        combo_arrow_thin {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&arrow_thin>;
        };

        // U + I = =>
        combo_arrow_fat {
            timeout-ms = <40>;
            key-positions = <6 7>;
            bindings = <&arrow_fat>;
        };

        // M + , = Caps Word (Gõ tên biến CONSTANT_CASE tự động tắt khi nhấn Space)
        combo_caps_word {
            timeout-ms = <45>;
            key-positions = <26 27>;
            bindings = <&caps_word>;
        };

        // X + C = Copy trong Terminal (Ctrl+Shift+C)
        combo_term_copy {
            timeout-ms = <45>;
            key-positions = <21 22>;
            bindings = <&kp LC(LS(C))>;
        };

        // C + V = Paste trong Terminal (Ctrl+Shift+V)
        combo_term_paste {
            timeout-ms = <45>;
            key-positions = <22 23>;
            bindings = <&kp LC(LS(V))>;
        };

        // --- Combos vào chế độ nạp Firmware (Bootloader) ---
        boot_left {
            bindings = <&bootloader>;
            key-positions = <33 32 30>;
        };

        boot_right {
            bindings = <&bootloader>;
            key-positions = <36 37 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Sơ đồ vị trí 50 phím (5 hàng x 10 cột):
         * Hàng 0 (0..9):   Q  W  E  R  T               Y  U  I  O  P
         * Hàng 1 (10..19): A  S  D  F  G               H  J  K  L  ;  (Home Row Mods: G-A-C-S)
         * Hàng 2 (20..29): Z  X  C  V  B               N  M  ,  .  /
         * Hàng 3 (30..39): [ÚtT] [T1] [T2] [T3] [EncT] [EncP] [P1] [P2] [P3] [ÚtP]
         * Hàng 4 (40..49): [Nav Trái: 40..44]          [Nav Phải: 45=Trái, 46=Xuống, 47=Giữa, 48=Lên, 49=Phải]
         */

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q        &kp W        &kp E         &kp R         &kp T          &kp Y       &kp U         &kp I         &kp O        &kp P
&hm LGUI A   &hm LALT S   &hm LCTRL D   &hm LSHFT F   &kp G          &kp H       &hm RSHFT J   &hm RCTRL K   &hm RALT L   &hm RGUI SEMI
&kp Z        &kp X        &kp C         &kp V         &kp B          &kp N       &kp M         &kp COMMA     &kp DOT      &kp FSLH
&mt LC(B) TAB &lt NUM_FN ESC &lt NAV_WM SPACE &lt AGENT_SYS TAB &mkp RCLK  &mkp MCLK &lt SYM_CODE RET &lt SYM_CODE BSPC &lt NUM_FN DEL &kp SQT
&none        &none        &none         &none         &none          &mmv MOVE_LEFT &mmv MOVE_DOWN &mkp LCLK &mmv MOVE_UP &mmv MOVE_RIGHT
            >;

            // Con lăn Trái: Cuộn dọc | Con lăn Phải (dự phòng): Cuộn dọc
            sensor-bindings = <&Scroll_D_U>, <&Scroll_U_D>;
        };

        /*
         * LAYER 1: NAV & WINDOW MANAGER (Giữ SPACE ngón cái trái)
         * - Tay phải: Điều hướng HJKL chuẩn Vim + Home/PgDn/PgUp/End + Nhảy từ (Ctrl+Left/Right)
         * - Tay trái: Giữ nguyên Modifiers ở Home Row + Undo/Cut/Copy/Paste + Click chuột Trái/Phải/Giữa
         * - Cụm Navigate 5 hướng bên phải: Chuyển Desktop ảo (Win+Ctrl+Left/Right), Snap cửa sổ (Win+Up/Down), Task View (Win+Tab)
         * - Con lăn bên trái: Cuộn ngang (Scroll Left/Right)
         */
        nav_layer {
            display-name = "Nav & WM";
            bindings = <
&kp ESC      &kp LC(W)    &mkp LCLK     &mkp RCLK     &kp LC(T)      &kp HOME    &kp PG_DN     &kp PG_UP     &kp END      &kp INS
&kp LGUI     &kp LALT     &kp LCTRL     &kp LSHFT     &mkp MCLK      &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT    &kp LC(FSLH)
&kp LC(Z)    &kp LC(X)    &kp LC(C)     &kp LC(V)     &kp LC(Y)      &kp LC(LEFT) &msc SCRL_DOWN &msc SCRL_UP &kp LC(RIGHT) &kp K_APP
&trans       &trans       &trans        &trans        &mkp LCLK      &trans      &kp RET       &kp BSPC      &kp DEL      &trans
&trans       &trans       &trans        &trans        &trans         &kp LG(LC(LEFT)) &kp LG(DOWN) &kp LG(TAB) &kp LG(UP) &kp LG(LC(RIGHT))
            >;

            sensor-bindings = <&Scroll_LR>, <&Scroll_RL>;
        };

        /*
         * LAYER 2: SYMBOLS & CODING (Giữ ENTER hoặc BACKSPACE ngón cái phải)
         * - Toàn bộ ngoặc (), [], {}, <> nằm ngay dưới tay thuận để code nhanh
         * - Cụm Navigate 5 hướng bên phải: Biến thành 4 phím Mũi tên (Left/Down/Up/Right) + Enter ở giữa
         * - Con lăn bên trái: Cuộn để Undo / Redo (Ctrl+Z / Ctrl+Y)
         */
        sym_layer {
            display-name = "Symbols";
            bindings = <
&kp EXCL     &kp AT       &kp HASH      &kp DLLR      &kp PRCNT      &kp CARET   &kp AMPS      &kp ASTRK     &kp LPAR     &kp RPAR
&kp GRAVE    &kp TILDE    &kp LPAR      &kp RPAR      &kp UNDER      &kp MINUS   &kp EQUAL     &kp LBKT      &kp RBKT     &kp BSLH
&kp PIPE     &kp LT       &kp LBRC      &kp RBRC      &kp GT         &kp PLUS    &kp COLON     &kp SEMI      &kp DQT      &kp QMARK
&trans       &trans       &kp SPACE     &trans        &trans         &trans      &trans        &trans        &trans       &trans
&trans       &trans       &trans        &trans        &trans         &kp LEFT    &kp DOWN      &kp RET       &kp UP       &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp LC(Y) LC(Z)>, <&inc_dec_kp RIGHT LEFT>;
        };

        /*
         * LAYER 3: NUMPAD & FUNCTION KEYS (Giữ ESC trái hoặc DEL phải)
         * - Tay trái: F1..F12 (phục vụ Debug: F5 Run, F9 Breakpoint, F10 Step Over, F11 Step Into, F12 Go to Def)
         * - Tay phải: Numpad chuẩn để nhập số nhanh
         * - Cụm Navigate 5 hướng bên phải: Chuyển Tab trước/sau (Ctrl+PgUp/PgDn) & Zoom In/Out (Ctrl+Plus/Minus)
         */
        num_layer {
            display-name = "Num & Fn";
            bindings = <
&kp F1       &kp F2       &kp F3        &kp F4        &kp F5         &kp FSLH    &kp N7        &kp N8        &kp N9       &kp MINUS
&hm LGUI F6  &hm LALT F7  &hm LCTRL F8  &hm LSHFT F9  &kp F10        &kp ASTRK   &kp N4        &kp N5        &kp N6       &kp PLUS
&kp F11      &kp F12      &kp PSCRN     &kp SLCK      &kp PAUSE_BREAK &kp N0     &kp N1        &kp N2        &kp N3       &kp DOT
&trans       &trans       &trans        &trans        &trans         &trans      &kp N0        &kp EQUAL     &kp COMMA    &trans
&trans       &trans       &trans        &trans        &trans         &kp LC(PG_UP) &kp LC(MINUS) &kp LC(N0)  &kp LC(PLUS) &kp LC(PG_DN)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * LAYER 4: CODING AGENT, TERMINAL & SYSTEM (Giữ TAB ngón cái trái)
         * - Tay trái: Phím tắt gọi nhanh Coding Agent (Chat, Inline Edit, Command Palette, Terminal, Chụp ảnh màn hình, Clipboard)
         * - Hàng dưới tay trái: Chuyển nhanh ứng dụng/Workspace 1..5 (Win+1..5)
         * - Tay phải: Quản lý kết nối Bluetooth (BT 0..4), Đổi USB/BLE, Tắt nguồn mềm
         */
        agent_sys_layer {
            display-name = "Agent & Sys";
            bindings = <
&kp LA(SPACE) &kp LC(LS(P)) &kp LC(P)   &kp LC(GRAVE) &code_fence    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
&kp LC(L)    &kp LC(I)    &kp LC(K)     &kp LG(LS(S)) &kp LG(V)      &out OUT_TOG &kp C_PREV   &kp C_PP     &kp C_NEXT   &soft_off
&kp LG(N1)   &kp LG(N2)   &kp LG(N3)    &kp LG(N4)    &kp LG(N5)     &bt BT_CLR   &bt BT_NXT   &bt BT_PRV   &none        &bt BT_CLR_ALL
&trans       &trans       &trans        &trans        &kp C_MUTE     &trans       &trans       &trans       &trans       &trans
&trans       &trans       &trans        &trans        &trans         &kp C_PREV   &kp C_VOL_DN &kp C_PP     &kp C_VOL_UP &kp C_NEXT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp C_NEXT C_PREV>;
        };
    };
};
